# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node (if any tooling added later)
node_modules/
dist/
.vite/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Large media — track files, exports, video renders stay LOCAL ONLY
*.wav
*.mp3
*.flac
*.aiff
*.mp4
*.mov
*.mkv
*.webm
*.psd
*.ai

# Allow tiny placeholder/sample files only via explicit allow-list
!assets/samples/**/*.mp3

# Notion backups — local snapshots only, never commit
scripts/backups/

# Personal journal — local only, never commit (whitelist README only)
journal/*
!journal/README.md
