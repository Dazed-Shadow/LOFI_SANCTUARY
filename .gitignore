# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node (if any tooling added later)
node_modules/
dist/
.vite/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Large media — track files, exports, video renders stay LOCAL ONLY
*.wav
*.mp3
*.flac
*.aiff
*.mp4
*.mov
*.mkv
*.webm
*.psd
*.ai

# Artist media + images — everything under assets/ stays local
# (whitelist .gitkeep markers so the directory structure persists in the repo)
assets/**
!assets/**/
!assets/**/.gitkeep

# Notion backups — local snapshots only, never commit
scripts/backups/

# Personal journal — local only, never commit (whitelist README only)
journal/*
!journal/README.md

# EPK asset binaries — local until JR explicitly stages cover art
# Whitelist only the .gitkeep so the directory stays in the repo
epk/assets/*
!epk/assets/.gitkeep
