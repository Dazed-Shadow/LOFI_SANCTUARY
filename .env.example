# Copy to .env (gitignored) and fill in real values.
# .env is NEVER committed.

# ── Notion ───────────────────────────────────────────────────────────────────
# Required to run scripts/notion_backup.py and notion_setup.py.
# Create at https://www.notion.so/profile/integrations
#   Type: Internal
#   Workspace: LOFI Sanctuary
# After creating, connect it to the MR_C-LOFI_SANCTUARY landing page in Notion
# (•••  → Connections → add this integration). Databases under it inherit.
NOTION_API_KEY=ntn_REPLACE_ME

# Landing page (parent for all databases)
NOTION_ROOT_PAGE_ID=363c30e1314880319921dcf0a2f7770b

# Database IDs (used by notion_backup.py). Defaults are baked into the script,
# but you can override here if you ever recreate a DB.
NOTION_ASSET_LIBRARY_DB=cdf82b386d3b4bd28ea250ea0d4fbb05
NOTION_PROMPT_LIBRARY_DB=d41b2e5f8481479e93e12d3d209ec4ec
NOTION_OUTREACH_CRM_DB=5338e679565a4caf85fdcae8dfa39f4d
NOTION_CONTENT_PIPELINE_DB=019118f7c515411ab4fe38b8e2cd1b45
NOTION_SESSION_LOG_DB=7e81ea6e91fc4d4aad6d24620eda593a
NOTION_BACKLOG_DB=9d0a30fd4fef43c4ad788770f8fcaaa5
NOTION_OWNER_LOG_DB=8e7af2a7f62d41b5a67bf530472bc1be
NOTION_REFERENCES_DB=7ae8adbd39b04bbba01187c5801312c5
